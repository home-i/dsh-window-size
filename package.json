{
  "name": "dsh-window-size",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Remembers the DeepSeek Harness Desktop window size, keeps it centered, and exposes a settings page to set it.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop",
    "window-size",
    "electron"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/home-i/dsh-window-size.git"
  },
  "homepage": "https://github.com/home-i/dsh-window-size#readme",
  "bugs": {
    "url": "https://github.com/home-i/dsh-window-size/issues"
  },
  "os": [
    "win32"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "window-memory.js",
    "rpc.js",
    "win32.js",
    "state.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
